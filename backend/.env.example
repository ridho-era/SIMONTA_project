# Salin menjadi .env untuk development. Jangan pernah commit .env atau kredensial SMTP.
SECRET_KEY=ganti-dengan-secret-key-lokal
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=simonta
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Celery + Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Development: email dicetak di terminal worker, bukan dikirim ke alamat asli.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIMONTA <no-reply@simonta.local>
